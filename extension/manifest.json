{
  "manifest_version": 3,
  "name": "Traditional Wedding Dress Website",
  "version": "1.4.0",
  "description": "Publish traditional wedding-dress articles with photos to your website.",
  "action": {
    "default_title": "Open the wedding-dress publisher"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://*.supabase.co/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://traditionalweddingdress.com;"
  }
}
